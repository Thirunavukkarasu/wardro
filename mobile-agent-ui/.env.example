# Base URL of the FastAPI agent service. Do not include a trailing slash.
# For a physical Android device, use the computer's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Development-only identity sent in the chat request body. The backend accepts
# these only with APP_ENV=development; production requires authentication.
EXPO_PUBLIC_USER_ID=dev-user
EXPO_PUBLIC_HOUSEHOLD_ID=dev-family
EXPO_PUBLIC_PROFILE_ID=dev-profile
