{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "seed:demo": "bun run ../scripts/seed-demo.mjs",
    "seed:demo:dry": "bun run ../scripts/seed-demo.mjs --dry-run"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.12.1",
    "@google-cloud/storage": "^8.4.0",
    "@hono/node-server": "^1.13.8",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.5.9",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.0.0"
  }
}
