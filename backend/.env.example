# Copy to `.env` for local development. Never commit `.env` itself.

# Firebase / Google Cloud project. Firebase is used only for authentication.
FIREBASE_PROJECT_ID=wardo-ce8d5

# Google Cloud Storage bucket for item photos (managed by this API).
GCS_PHOTOS_BUCKET=wardo-ce8d5-wardrobe-photos
# Public origin used to build photo URLs. Leave empty locally to use the
# request origin; set it in Cloud Run to the service URL.
# PUBLIC_API_ORIGIN=https://wardro-api-251900114942.asia-south1.run.app
# Signs the stable /api/photos/... URLs. Use a long random value locally;
# production reads it from the PHOTO_URL_SECRET Secret Manager secret.
PHOTO_URL_SECRET=wardo-local-photo-secret

# Item auto-fill (Ollama OpenAI-compatible API). Leave the models empty to
# disable AI drafts; URL imports still use page metadata.
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_API_KEY=
# Current Ollama Cloud model (vision + tools):
# OLLAMA_TEXT_MODEL=deepseek-v4.1-flash:1017-cloud
# OLLAMA_VISION_MODEL=deepseek-v4.1-flash:1017-cloud

# Postgres (Neon in production). Any Postgres connection string works.
DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=false
# DATABASE_POOL_MAX=5

# Optional: serve the checked-in simulation images from another directory.
# DEMO_IMAGES_DIR=/absolute/path/to/scripts/datasets/wardrobe-simulation

# Optional: extra browser origins allowed to call the API, comma-separated.
# CORS_ORIGINS=https://wardro-lake.vercel.app

# Cloud Run deployment details, for reference. The workflow in
# `.github/workflows/deploy-api.yml` reads these from GitHub repository
# variables, not from this file.
# GCP_PROJECT_ID=wardo-ce8d5
# GCP_PROJECT_NUMBER=251900114942
# GCP_REGION=asia-south1
# CLOUD_RUN_SERVICE=wardro-api
# CLOUD_RUN_SERVICE_ACCOUNT=wardro-api@wardo-ce8d5.iam.gserviceaccount.com
