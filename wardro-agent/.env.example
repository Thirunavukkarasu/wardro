# Application
APP_NAME=Wardro AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Ollama (local inference only; no cloud LLM providers)
OLLAMA_BASE_URL=http://localhost:11434
# Use any installed model. A vision-capable tag is required for photo analysis;
# for example deepseek-v4.1-flash:cloud if your Ollama account exposes it.
# If qwen3/qwen3-vl are not pulled yet, use an installed tag until they are.
OLLAMA_CHAT_MODEL=qwen3
OLLAMA_VISION_MODEL=qwen3-vl
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=1024
OLLAMA_DISABLE_THINKING=true
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_HEALTH_TIMEOUT=5

# Request limits
MAX_MESSAGE_LENGTH=8000
MAX_HISTORY_MESSAGES=10

# Browser origins allowed to call the API. The Expo web client runs on 8081 by
# default. Development also accepts any localhost port via CORS_ORIGIN_REGEX.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Reserved for the LangGraph checkpointer. Persistence is not enabled yet;
# build_checkpointer() currently returns None.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wardro_ai

# Read-only inventory source. The chat request's development Firebase token is
# forwarded to {BACKEND_API_URL}/api/wardrobeItems with X-Profile-Id. The token
# is never logged or stored in graph state/checkpoints.
BACKEND_API_URL=http://localhost:3000
