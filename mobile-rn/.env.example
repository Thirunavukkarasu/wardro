# Copy to .env. All EXPO_PUBLIC_* values are embedded in the client bundle,
# so only put public configuration here (never service-account keys).

# Hono backend, including the /api prefix. The deployed service is
# wardro-api in wardo-ce8d5/asia-south1 (created by
# .github/workflows/deploy-api.yml). For local development use
# http://localhost:3000/api (or 10.0.2.2 for the Android emulator).
EXPO_PUBLIC_API_URL=https://wardro-api-251900114942.asia-south1.run.app/api

# Local FastAPI agent service (wardro-agent). Use http://localhost:8000 for
# web, http://10.0.2.2:8000 for the Android emulator, or your LAN IP for a
# physical device.
EXPO_PUBLIC_AGENT_URL=http://localhost:8000

# Firebase web app configuration (Project settings → Your apps).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth *client* IDs, not Firebase app IDs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
